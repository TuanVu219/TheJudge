[sub_resource type="GDScript" id="Script_PreviewSetup"]
script/source = "extends Node3D

func _ready() -> void:
	$PlayerMint.set_display_name(\"Minty\")
	$PlayerMint.set_body_color(Color(0.43, 0.88, 0.66))
	$PlayerMint.set_accessory_visible(\"TinyHat\", false)
	$PlayerMint.set_accessory_visible(\"Feather\", true)
	$PlayerMint.set_display_name_visible(false)

	$PlayerCoral.set_display_name(\"Peaches\")
	$PlayerCoral.set_body_color(Color(1.0, 0.58, 0.37))
	$PlayerCoral.set_accessory_visible(\"TinyHat\", true)
	$PlayerCoral.set_display_name_visible(false)

	$PlayerSky.set_display_name(\"Bubbles\")
	$PlayerSky.set_body_color(Color(0.38, 0.72, 1.0))
	$PlayerSky.set_accessory_visible(\"TinyHat\", false)
	$PlayerSky.set_accessory_visible(\"TinyGlasses\", true)
	$PlayerSky.set_display_name_visible(false)"

