layout_mode = 2
theme_override_constants/separation = 8

[node name="PreviewTitle" type="Label" parent="Layout/Columns/PreviewCard/PreviewContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.12, 0.25, 0.36, 1)
theme_override_font_sizes/font_size = 21
text = "MEET THE COURT"
horizontal_alignment = 1

[node name="PreviewCaption" type="Label" parent="Layout/Columns/PreviewCard/PreviewContent"]
layout_mode = 2
theme_override_colors/font_color = Color(0.23, 0.4, 0.46, 1)
theme_override_font_sizes/font_size = 15
text = "Three beans. One very silly trial."
horizontal_alignment = 1

[node name="PreviewFrame" type="PanelContainer" parent="Layout/Columns/PreviewCard/PreviewContent"]
layout_mode = 2
size_flags_vertical = 3
theme_override_styles/panel = SubResource("SubtleNormal")

[node name="PreviewViewport" type="SubViewportContainer" parent="Layout/Columns/PreviewCard/PreviewContent/PreviewFrame"]
custom_minimum_size = Vector2(0, 440)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
stretch = true
mouse_filter = 2

[node name="SubViewport" type="SubViewport" parent="Layout/Columns/PreviewCard/PreviewContent/PreviewFrame/PreviewViewport"]
